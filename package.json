{
  "name": "mundo-de-miriam",
  "private": true,
  "version": "1.0.0",
  "description": "Portfólio da Miriam Cléres Forastieri — web (Vue) + api (Fastify no Cloudflare Workers)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "dev:api": "npm run dev --workspace api",
    "build": "npm run build --workspace web",
    "db:migrate": "npm run db:migrate --workspace api",
    "db:migrate:local": "npm run db:migrate:local --workspace api",
    "db:seed:admin": "npm run db:seed:admin --workspace api",
    "db:seed:media": "npm run db:seed:media --workspace api"
  }
}
